# Copy to .env at the repo root. Every workspace (api, agent) reads this one file.

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Deployment tier: development | staging | production.
#   development  lenient: integrations may be unconfigured, dev identities allowed
#   staging      strict (real secrets, World ID required), World ID simulator + testnets
#   production   strict, real World App only
# Staging and production refuse to boot on an unsafe config (api/src/config/config.ts).
# `npm run dev` uses development; the Docker app defaults to staging.
APP_ENV=development
PORT=3000
DATABASE_URL=postgres://kneedeep:kneedeep@localhost:5434/kneedeep
# Salt for public reporter pseudonyms: pseudonym = sha256(salt || World ID nullifier).
# Set it once (openssl rand -hex 32) and never change it, or every reporter gets a new pseudonym.
PSEUDONYM_SALT=change-me-to-a-long-random-string
# Browser origins allowed to call the API, comma-separated. Empty = same origin only
# (plus any localhost port in development). Not needed when the API serves the web app.
CORS_ORIGINS=
# Proxy hops in front of the API (1 behind a load balancer), so rate limits see real client IPs.
TRUST_PROXY=0
# Apply pending migrations at startup (handy for single-container deploys).
MIGRATE_ON_BOOT=false

# ---------------------------------------------------------------------------
# Arkiv (Rabdi testnet). Reports live here, with a native expiry.
#   Access key: https://hub.arkiv.network/access-keys  (empty = public, heavily rate limited)
#   Wallet:     npm run arkiv:wallet  -> paste the key here, fund the address at
#               https://hub.arkiv.network/faucet
# ---------------------------------------------------------------------------
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=
# How long a report lives on Arkiv. 3h in production; set to e.g. 120 for the "truth expires" demo.
# Must be a whole number of Arkiv blocks.
REPORT_TTL_SECONDS=10800
# world = World ID proof required, reports are live. dev = no proof, every report is labelled simulated.
REPORTER_VERIFIER=world
# One report per human per ~150 m cell per this many minutes.
REPORT_RATE_LIMIT_MINUTES=30
# Only people this close to a report may confirm or dispute it.
VOTE_MAX_DISTANCE_M=1000

# ---------------------------------------------------------------------------
# Hedera (testnet). Account from https://portal.hedera.com
# The platform account receives x402 payments and sends reporter payouts.
# ---------------------------------------------------------------------------
HEDERA_NETWORK=hedera:testnet
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# ECDSA | ED25519 (portal accounts are ECDSA by default; DER-encoded keys are detected automatically)
HEDERA_KEY_TYPE=ECDSA
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# x402 facilitator listed by Hedera (testnet, no API key):
#   Blocky402: https://api.testnet.blocky402.com
#   x402.org:  https://x402.org/facilitator
FACILITATOR_URL=https://api.testnet.blocky402.com
# Price of one GET /v1/conditions, in tinybars (1 HBAR = 100_000_000).
CONDITIONS_PRICE_TINYBARS=10000000

# Reporter payouts. This share of every paid query is credited to the verified humans whose live,
# corroborated reports it used; the rest stays with the platform.
REPORTER_SHARE_PERCENT=70
# The API pays out every N minutes (0 = only on demand: npm run payout).
PAYOUT_INTERVAL_MINUTES=60
# Accounts owed less than this (tinybars) wait for a later batch.
PAYOUT_MIN_TINYBARS=1000000
# Recipients per Hedera transfer (max 9: Hedera allows 10 transfers per transaction, one is the platform).
PAYOUT_MAX_RECIPIENTS=9

# ---------------------------------------------------------------------------
# World ID (https://developer.world.org)
# ---------------------------------------------------------------------------
WORLD_APP_ID=
WORLD_RP_ID=
# Server-only. Never ship this to the browser.
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=submit-report
# production = real World App. staging = World ID simulator (https://simulator.worldcoin.org) for testing.
WORLD_ENVIRONMENT=production
# Accept legacy World ID 3.0 Orb proofs if World App cannot produce a 4.0 Proof of Human.
# 3.0 and 4.0 nullifiers differ, so one person could hold two pseudonyms. Keep false unless needed.
WORLD_ALLOW_LEGACY_PROOFS=false
# After one Proof of Human, a reporter session lasts this long.
REPORTER_SESSION_HOURS=12

# ---------------------------------------------------------------------------
# Independent verification (Chainlink CRE, cre/README.md). Optional: empty = not shown.
# The KneeDeepAttestations contract the CRE workflow writes to (Sepolia).
# ---------------------------------------------------------------------------
CRE_ATTESTATIONS_ADDRESS=
CRE_CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CRE_EXPLORER_URL=https://sepolia.etherscan.io

# ---------------------------------------------------------------------------
# Dispatch agent (agent/). Has its own Hedera account; it pays per query.
# ---------------------------------------------------------------------------
# npm run dev serves the API on 3000; Docker on 8080 (npm run demo:agent sets it for you).
KNEEDEEP_API_URL=http://localhost:3000
AGENT_HEDERA_ACCOUNT_ID=
AGENT_HEDERA_PRIVATE_KEY=
AGENT_HEDERA_KEY_TYPE=ECDSA
# Hard cap per paid query, in tinybars. The agent refuses to sign a payment above it.
AGENT_MAX_TINYBARS_PER_QUERY=20000000
# Budget for one trip (all checkpoints on all routes). The agent refuses to start above it.
AGENT_MAX_TINYBARS_PER_TRIP=100000000
