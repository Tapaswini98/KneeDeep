# KneeDeep server configuration. Copy to deploy/.env ON THE SERVER and fill in.
# deploy/.env is gitignored: never commit it. Check it before going live:
#   npm run deploy:check -- --env deploy/.env
# DATABASE_URL, PORT, MIGRATE_ON_BOOT and TRUST_PROXY are set by deploy/docker-compose.yml.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Public hostname; Caddy gets its HTTPS certificate for it. DNS must point here.
DOMAIN=kneedeep.example.com
# Database password (hex keeps it URL-safe): openssl rand -hex 24
POSTGRES_PASSWORD=
# Empty = build from this checkout. Or run a published release:
#   KNEEDEEP_IMAGE=ghcr.io/<github-owner>/kneedeep:1.0.0
KNEEDEEP_IMAGE=

# ---------------------------------------------------------------------------
# Tier
#   staging     strict, World ID SIMULATOR, testnets (demos, judging)
#   production  strict, real World App only (needs WORLD_ENVIRONMENT=production)
# ---------------------------------------------------------------------------
APP_ENV=staging

# Reporter pseudonym = sha256(salt || World ID nullifier). openssl rand -hex 32
# Set ONCE and never change it: a new salt gives every reporter a new identity and orphans earnings.
PSEUDONYM_SALT=
# Only if the web app is hosted on a different origin (it is served by the API by default).
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# World ID (https://developer.world.org). The action must exist in the same environment.
# ---------------------------------------------------------------------------
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=submit-report
# staging = simulator (https://simulator.worldcoin.org); production = World App
WORLD_ENVIRONMENT=staging
WORLD_ALLOW_LEGACY_PROOFS=false
REPORTER_SESSION_HOURS=12

# ---------------------------------------------------------------------------
# Arkiv (Rabdi testnet): reports are written here by this wallet. Keep it funded.
# ---------------------------------------------------------------------------
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=
REPORT_TTL_SECONDS=10800
REPORTER_VERIFIER=world
REPORT_RATE_LIMIT_MINUTES=30
VOTE_MAX_DISTANCE_M=1000

# ---------------------------------------------------------------------------
# Hedera: the platform account receives x402 payments and pays reporters (and their fees).
# ---------------------------------------------------------------------------
HEDERA_NETWORK=hedera:testnet
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_KEY_TYPE=ECDSA
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
FACILITATOR_URL=https://api.testnet.blocky402.com
CONDITIONS_PRICE_TINYBARS=10000000

# Reporter payouts
REPORTER_SHARE_PERCENT=70
PAYOUT_INTERVAL_MINUTES=60
PAYOUT_MIN_TINYBARS=1000000
PAYOUT_MAX_RECIPIENTS=9

# ---------------------------------------------------------------------------
# Independent verification (Chainlink CRE, cre/README.md). Optional: empty = not shown.
# The KneeDeepAttestations contract the CRE workflow writes to (Sepolia).
# ---------------------------------------------------------------------------
CRE_ATTESTATIONS_ADDRESS=
CRE_CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CRE_EXPLORER_URL=https://sepolia.etherscan.io
