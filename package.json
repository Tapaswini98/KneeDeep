{
  "name": "kneedeep",
  "version": "0.1.0",
  "private": true,
  "description": "Street-level truth for AI agents: verified, perishable, paid.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "api",
    "web",
    "agent"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w api\" \"npm run dev -w web\"",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "npm run db:migrate -w api",
    "db:reset": "npm run db:reset -w api",
    "arkiv:wallet": "npm run arkiv:wallet -w api",
    "arkiv:smoke": "npm run arkiv:smoke -w api",
    "hedera:balance": "npm run hedera:balance -w api",
    "agent": "npm run start -w agent",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "simulate": "npm run simulate -w api --",
    "arkiv:query": "npm run arkiv:query -w api --",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up --build -d && echo 'KneeDeep on http://localhost:8080 (map) and http://localhost:8080/report'",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "demo": "npm run docker:up && npm run demo:check",
    "demo:check": "npm run e2e -w api --",
    "demo:seed": "npm run seed -w api"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "concurrently": "9.2.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
