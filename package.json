{
  "name": "kneedeep",
  "version": "0.1.0",
  "private": true,
  "description": "Street-level truth for AI agents: verified, perishable, paid.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "api",
    "web",
    "agent"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w api\" \"npm run dev -w web\"",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "npm run db:migrate -w api",
    "db:reset": "npm run db:reset -w api",
    "arkiv:wallet": "npm run arkiv:wallet -w api",
    "arkiv:smoke": "npm run arkiv:smoke -w api",
    "hedera:balance": "npm run hedera:balance -w api",
    "agent": "npm run start -w agent",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "typescript": "5.9.3"
  }
}
